<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained publish: the .NET runtime is bundled, so nothing has to be installed first.
     Not single-file and not trimmed: WPF does not support trimming, and a plain folder starts faster
     than a single file that unpacks itself. ReadyToRun precompiles the code to speed up startup. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\win-x64\</PublishDir>

    <!-- Only the languages the app uses: WPF and other packages ship a folder per UI language. -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Leave out debug symbols, including the very large one that comes with the native Skia library. -->
  <Target Name="TrimxRemovePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
