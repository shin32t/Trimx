<Window x:Class="Trimx.UI.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カラーピッカー"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style x:Key="ValueBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="ChannelLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="16" />
            <Setter Property="Margin" Value="0,0,4,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16"
                Orientation="Horizontal">
        <!-- Saturation (left to right) and brightness (bottom to top) of the current hue. -->
        <Grid x:Name="SquareHost"
              Width="256"
              Height="256"
              Cursor="Cross"
              Background="Transparent"
              ClipToBounds="True"
              MouseLeftButtonDown="OnSquareMouse"
              MouseMove="OnSquareMouse">
            <Rectangle x:Name="HueFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SquareThumb"
                         Width="12"
                         Height="12"
                         Stroke="White"
                         StrokeThickness="2" />
            </Canvas>
        </Grid>

        <Grid x:Name="HueHost"
              Width="24"
              Height="256"
              Margin="12,0,0,0"
              Cursor="Hand"
              Background="Transparent"
              MouseLeftButtonDown="OnHueMouse"
              MouseMove="OnHueMouse">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                        <GradientStop Color="#00FF00" Offset="0.3333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.6667" />
                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Border x:Name="HueThumb"
                        Width="24"
                        Height="6"
                        BorderBrush="White"
                        BorderThickness="2" />
            </Canvas>
        </Grid>

        <StackPanel Margin="16,0,0,0"
                    Width="150">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="新しい色" />
                    <Border x:Name="NewSwatch"
                            Height="40"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0">
                    <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="現在の色" />
                    <Border x:Name="OldSwatch"
                            Height="40"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ChannelLabelStyle}"
                                   Text="H" />
                        <TextBox x:Name="HueBox"
                                 Style="{StaticResource ValueBoxStyle}"
                                 ToolTip="色相 (0-360)"
                                 TextChanged="OnHsvBoxChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ChannelLabelStyle}"
                                   Text="S" />
                        <TextBox x:Name="SaturationBox"
                                 Style="{StaticResource ValueBoxStyle}"
                                 ToolTip="彩度 (0-100)"
                                 TextChanged="OnHsvBoxChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ChannelLabelStyle}"
                                   Text="B" />
                        <TextBox x:Name="ValueBox"
                                 Style="{StaticResource ValueBoxStyle}"
                                 ToolTip="明るさ (0-100)"
                                 TextChanged="OnHsvBoxChanged" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ChannelLabelStyle}"
                                   Text="R" />
                        <TextBox x:Name="RedBox"
                                 Style="{StaticResource ValueBoxStyle}"
                                 ToolTip="赤 (0-255)"
                                 TextChanged="OnRgbBoxChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ChannelLabelStyle}"
                                   Text="G" />
                        <TextBox x:Name="GreenBox"
                                 Style="{StaticResource ValueBoxStyle}"
                                 ToolTip="緑 (0-255)"
                                 TextChanged="OnRgbBoxChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ChannelLabelStyle}"
                                   Text="B" />
                        <TextBox x:Name="BlueBox"
                                 Style="{StaticResource ValueBoxStyle}"
                                 ToolTip="青 (0-255)"
                                 TextChanged="OnRgbBoxChanged" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource ChannelLabelStyle}"
                           Text="#" />
                <TextBox x:Name="HexBox"
                         Width="80"
                         Margin="0,0,0,6"
                         ToolTip="#RRGGBB"
                         TextChanged="OnHexBoxChanged" />
            </StackPanel>

            <StackPanel Margin="0,24,0,0">
                <Button Content="OK"
                        IsDefault="True"
                        Click="OnOk" />
                <Button Margin="0,8,0,0"
                        Content="キャンセル"
                        IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
