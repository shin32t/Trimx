<UserControl x:Class="Trimx.UI.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel>
            <!-- The swatch is the button that opens the color picker. The hand cursor and the highlighted border show it can be pressed. -->
            <Border x:Name="Swatch"
                    DockPanel.Dock="Left"
                    Width="28"
                    Height="24"
                    Margin="0,0,6,0"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="{DynamicResource color.open.tip}"
                    MouseLeftButtonUp="OnSwatchClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Button x:Name="NoneButton"
                    DockPanel.Dock="Right"
                    Margin="6,0,0,0"
                    Padding="8,2"
                    Content="{DynamicResource color.none}"
                    ToolTip="{DynamicResource color.none.tip}"
                    Visibility="Collapsed"
                    Click="OnNoneClick" />
            <TextBox x:Name="HexBox"
                     VerticalContentAlignment="Center"
                     ToolTip="{DynamicResource color.hex.tip}"
                     TextChanged="OnHexTextChanged"
                     LostFocus="OnHexLostFocus" />
        </DockPanel>
        <WrapPanel x:Name="Presets"
                   Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
