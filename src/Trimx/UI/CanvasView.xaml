<UserControl x:Class="Trimx.UI.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Focusable="True">
    <Grid x:Name="Root"
          SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <skia:SKElement x:Name="Surface"
                        Grid.Row="0"
                        Grid.Column="0"
                        PaintSurface="OnPaintSurface" />

        <!-- Edits a text layer in place (double-click the text) -->
        <TextBox x:Name="InlineEditor"
                 Grid.Row="0"
                 Grid.Column="0"
                 MinWidth="24"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 AcceptsReturn="True"
                 Background="#B0808080"
                 BorderBrush="{DynamicResource AccentBrush}"
                 BorderThickness="1"
                 Padding="0"
                 Visibility="Collapsed" />

        <ScrollBar x:Name="VerticalBar"
                   Grid.Row="0"
                   Grid.Column="1"
                   Width="12"
                   Orientation="Vertical"
                   Visibility="Collapsed"
                   ValueChanged="OnScrollBarValueChanged" />

        <ScrollBar x:Name="HorizontalBar"
                   Grid.Row="1"
                   Grid.Column="0"
                   Height="12"
                   Orientation="Horizontal"
                   Visibility="Collapsed"
                   ValueChanged="OnScrollBarValueChanged" />
    </Grid>
</UserControl>
