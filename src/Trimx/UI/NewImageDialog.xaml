<Window x:Class="Trimx.UI.NewImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規画像"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16"
                MinWidth="260">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="幅" />
            <TextBox x:Name="WidthBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,0,6" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Margin="6,0,0,6"
                       VerticalAlignment="Center"
                       Text="px" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="高さ" />
            <TextBox x:Name="HeightBox"
                     Grid.Row="1"
                     Grid.Column="1" />
            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Text="px" />
        </Grid>

        <TextBlock Margin="0,14,0,4"
                   Text="背景" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TransparentRadio"
                         Margin="0,0,14,0"
                         Content="透明"
                         IsChecked="True" />
            <RadioButton x:Name="WhiteRadio"
                         Margin="0,0,14,0"
                         Content="白" />
            <RadioButton x:Name="BlackRadio"
                         Content="黒" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="80"
                    Content="作成"
                    IsDefault="True"
                    Click="OnOk" />
            <Button MinWidth="80"
                    Margin="8,0,0,0"
                    Content="キャンセル"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
