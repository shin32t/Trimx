<Window x:Class="Trimx.UI.ResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="16"
                MinWidth="280">
        <TextBlock x:Name="CurrentSizeText"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="幅" />
            <TextBox x:Name="WidthBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,0,6"
                     TextChanged="OnWidthChanged" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Margin="6,0,0,6"
                       VerticalAlignment="Center"
                       Text="px" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="高さ" />
            <TextBox x:Name="HeightBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     TextChanged="OnHeightChanged" />
            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Text="px" />
        </Grid>

        <CheckBox x:Name="KeepRatioCheck"
                  Margin="0,10,0,0"
                  Content="縦横比を維持" />

        <!-- Canvas size only: where the existing content sits in the new canvas -->
        <StackPanel x:Name="AnchorSection"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
            <TextBlock Margin="0,0,0,4"
                       Text="元の画像の位置" />
            <UniformGrid x:Name="AnchorGrid"
                         Rows="3"
                         Columns="3"
                         HorizontalAlignment="Left" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="80"
                    Content="OK"
                    IsDefault="True"
                    Click="OnOk" />
            <Button MinWidth="80"
                    Margin="8,0,0,0"
                    Content="キャンセル"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
