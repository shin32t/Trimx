<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\branding\trimx.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Trimx</Product>
    <Authors>shin32t</Authors>
    <Copyright>Copyright (c) 2026 shin32t</Copyright>
    <!-- Release builds do not carry the source link / commit hash suffix, so the file version stays 0.1.0. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.156.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trimx.Core\Trimx.Core.csproj" />
  </ItemGroup>

</Project>
